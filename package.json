{
  "name": "pizza-to-the-polls",
  "private": false,
  "version": "1.0.0",
  "description": "Pizza to the Polls",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pizza-to-the-polls/polls.pizza"
  },
  "scripts": {
    "dev": "stencil build --dev --watch --serve",
    "postinstall": "patch-package",
    "build": "npm run clean && npm run lint && stencil build --prod --no-cache --prerender && node scripts/ensure-sourcemap-links.mjs",
    "bugsnag": "bugsnag-source-maps upload-browser --overwrite --api-key $BUGSNAG_KEY --directory dist/www --base-url ${ROOT_URL:-https://polls.pizza}",
    "clean": "rimraf dist/www",
    "start": "npm run dev",
    "fix": "npm run prettier:fix && npm run lint:fix",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "generate": "stencil generate",
    "test": "stencil test --spec --e2e",
    "test:watch": "stencil test --spec --e2e --watch",
    "ci": "npm run prettier && npm run lint && npm run test",
    "util:check-updates": "npm-check-updates",
    "util:perform-updates": "npm-check-updates -u"
  },
  "dependencies": {
    "@bugsnag/js": "^7.25.0",
    "@bugsnag/source-maps": "^2.3.3"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@stencil/core": "4.43.5",
    "@stencil/eslint-plugin": "^1.4.0",
    "@stencil/router": "^1.0.1",
    "@stencil/sass": "^2.0.4",
    "@types/google.maps": "^3.58.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "eslint-plugin-react": "^7.37.4",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "npm-check-updates": "^17.1.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.4.0",
    "puppeteer": "^23.6.0",
    "rimraf": "^5.0.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.16.0",
    "workbox-build": "^7.3.0"
  }
}
